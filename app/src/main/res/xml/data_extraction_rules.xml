<?xml version="1.0" encoding="utf-8"?>
<!--
  No app data leaves the device: no cloud backup and no device-to-device transfer.
  The refresh token is encrypted with a Keystore key that cannot move to another device,
  and the visitor IDs belong to this device. allowBackup="false" in the manifest covers the cloud backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
