<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cast_step1"
        android:textColor="@color/text_dim"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cast_path"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/cast_step2"
        android:textColor="@color/text_dim"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/cast_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.1"
        android:textColor="@color/accent"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cast_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="@color/text_dim"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/cast_unlink"
        style="@style/ActionButton"
        android:layout_marginTop="24dp"
        android:text="@string/cast_unlink"
        android:visibility="gone" />
</LinearLayout>
